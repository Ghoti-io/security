# OpenSSL 3.5.7 and Wycheproof 3fa63dd, in one image.
#
# Built here, so the finished image has no digest to pin. Everything the build
# reads is pinned instead: the Debian base by digest, the openssl and libxcrypt
# packages by full apt version, Wycheproof by commit. The pinned gcc compiles
# crypt-bcrypt, rc4-evp, rc2-evp, and ed25519-evp; those programs call the pinned libraries. The run-time checks —
# openssl-version, libcrypt-version, and the SHA-256 of aes_gcm_test.json —
# are what a second build has to satisfy.
# documentation/oracles.md.
#
# The apt pin stops resolving when the archive drops it. That failure is the
# point: an unpinned `apt-get install openssl` would silently move the oracle.
FROM docker.io/library/debian:13-slim@sha256:7792b1f7702a86946cd518db72b6a407302c3e9bc1635634368b878189e8221c

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# debian:13-slim already lists trixie-security, signed with the archive's
# .pgp keyring. A second stanza for the same suite is rejected when its
# Signed-By differs, which is what an extra security.sources file did.
# The version pin is the guarantee: main may still be on an older openssl,
# and an unpinned install would take it.
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends \
      openssl=3.5.7-1~deb13u2 \
      libssl-dev=3.5.7-1~deb13u2 \
      libcrypt-dev=1:4.4.38-1 \
      libc6-dev=2.41-12+deb13u4 \
      gcc=4:14.2.0-1 \
      ca-certificates \
      git \
    && rm -rf /var/lib/apt/lists/*

COPY crypt-bcrypt.c rc4-evp.c rc2-evp.c ed25519-evp.c /tmp/oracle-helpers/
RUN gcc -O2 -o /usr/local/bin/crypt-bcrypt /tmp/oracle-helpers/crypt-bcrypt.c -lcrypt \
    && gcc -O2 -o /usr/local/bin/rc4-evp /tmp/oracle-helpers/rc4-evp.c -lcrypto \
    && gcc -O2 -o /usr/local/bin/rc2-evp /tmp/oracle-helpers/rc2-evp.c -lcrypto \
    && gcc -O2 -o /usr/local/bin/ed25519-evp /tmp/oracle-helpers/ed25519-evp.c -lcrypto \
    && rm -rf /tmp/oracle-helpers

RUN git init /opt/wycheproof \
    && git -C /opt/wycheproof remote add origin https://github.com/C2SP/wycheproof.git \
    && git -C /opt/wycheproof fetch --depth 1 origin 3fa63dd0344abb611f1fb1d77e119938603ea230 \
    && git -C /opt/wycheproof checkout --detach FETCH_HEAD \
    && git -C /opt/wycheproof rev-parse HEAD > /opt/wycheproof/PIN \
    && rm -rf /opt/wycheproof/.git

COPY openssl-version wycheproof-pin libcrypt-version /usr/local/bin/
RUN chmod 0755 /usr/local/bin/openssl-version /usr/local/bin/wycheproof-pin \
    /usr/local/bin/libcrypt-version
