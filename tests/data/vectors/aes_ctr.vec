# AES-CTR known answers.
# be is the NIST counter: the block increments as a big-endian integer.
# le is the WinZip counter: little-endian. Those digests are checked
# against encryption of the successive counter blocks.
# make check-oracle compares the be cases with OpenSSL.
primitive aes-ctr

case be-128-16
direction be
key 000102030405060708090a0b0c0d0e0f
counter 00000000000000000000000000000001
pt 68656c6c6f20637472206d6f64652121
ct 1b237ff9fae0d76a3b5bd08c01910c2b

case be-128-20
direction be
key 000102030405060708090a0b0c0d0e0f
counter 00000000000000000000000000000001
pt 6161616161616161616161616161616161616161
ct 122772f4f4a1d57f281adc8204954c6b28b7e632

case be-192-20
direction be
key 000102030405060708090a0b0c0d0e0f1011121314151617
counter 00000000000000000000000000000001
pt 6161616161616161616161616161616161616161
ct 282f593b2a5eced6728b8dc969030676ba6273ea

case le-128-20
direction le
key 000102030405060708090a0b0c0d0e0f
counter 01000000000000000000000000000000
pt 6161616161616161616161616161616161616161
ct 821db202bc1de6c1fb9e6f5f0181fde39aeb827a

case be-empty
direction be
key 00000000000000000000000000000000
counter 00000000000000000000000000000000
pt -
ct -
