# One Wycheproof RSASSA-PKCS1-v1_5 SHA-256 case, and MD5 and SHA-1 signatures
# OpenSSL 3.5.7 produced for the ASCII bytes of "sample".
primitive rsa_pkcs1_v15_verify
case wycheproof-2048-sha256
hash sha256
n 
e 010001
msg -
sig 
case openssl-md5-sample
hash md5
n 
e 010001
msg 73616d706c65
sig 
case openssl-sha1-sample
hash sha1
n 
e 010001
msg 73616d706c65
sig 
