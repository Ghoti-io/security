# bcrypt known answers.
# stars and empty are OpenBSD vectors. ASCII matches $2a$ and $2b$.
# high is the $2b$ tag of ff ff a3. high-2a is crypt_blowfish's $2a$
# tag of that same password: the collision tweak, not the sign extension.
# lead-2x is the $2x$ tag of a lone 0x80, which $2b$ hashes differently.
primitive bcrypt

case stars
password 552a552a
salt 10410410410410410410410410410410
cost 5
hash 5c84350bdfbaa96ac16f615ae79f35cfdacd682d369f2389

case empty
password -
salt 10410410410410410410410410410410
cost 5
hash f702365c4d4ae1d53d97cd28b0b93f11f79fce44d560fdf1

case high
password ffffa3
salt 05030085d5ed4c176b2ac3cbee47291c
cost 5
hash 106ee09c971c43a19d8a25c595df91dff4f09b56543b980c

case high-2a
password ffffa3
salt 05030085d5ed4c176b2ac3cbee47291c
cost 5
hash a6c7f7cb402b54e7dec6d4d8cf490837880ed40e1cfbb046

