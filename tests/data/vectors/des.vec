# DES and three-key Triple DES known answers. No padding.
primitive des

case fips-ecb
mode ecb
key 133457799bbcdff1
iv -
pt 0123456789abcdef
ct 85e813540f0ab405

case cbc-two
mode cbc
key 133457799bbcdff1
iv 0000000000000000
pt 0123456789abcdef0123456789abcdef
ct 85e813540f0ab405eb46291166493cd4

case ede3-ecb
mode ede3
key 0123456789abcdef5555555555555555fedcba9876543210
iv -
pt 0123456789abcdef
ct 6b9ef97b5c955c29
