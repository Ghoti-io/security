# PBKDF2 known answers.
# sha1-rfc6070-* are RFC 6070. The 16,777,216-iteration case is omitted:
# it is the same function as c=4096 with a public count, and it does not
# belong in make test. password and salt are hex so a NUL in the password
# is representable. make check-oracle recomputes these with the pinned OpenSSL.
primitive pbkdf2

case sha1-rfc6070-1
hash sha1
password 70617373776f7264
salt 73616c74
iterations 1
dk 0c60c80f961f0e71f3a9b524af6012062fe037a6

case sha1-rfc6070-2
hash sha1
password 70617373776f7264
salt 73616c74
iterations 2
dk ea6c014dc72d6f8ccd1ed92ace1d41f0d8de8957

case sha1-rfc6070-4096
hash sha1
password 70617373776f7264
salt 73616c74
iterations 4096
dk 4b007901b765489abead49d926f721d065a429c1

case sha1-rfc6070-long
hash sha1
password 70617373776f726450415353574f524470617373776f7264
salt 73616c7453414c5473616c7453414c5473616c7453414c5473616c7453414c5473616c74
iterations 4096
dk 3d2eec4fe41c849b80c8d83662c0e44a8b291a964cf2f07038

case sha1-rfc6070-nul
hash sha1
password 7061737300776f7264
salt 7361006c74
iterations 4096
dk 56fa6aa75548099dcc37d7f03425e0c3

